    "tabs": [
     {
      "id": "home",
      "label": "HOME",
      "icon": "house",
      "screen": "home"
     },
     {
      "id": "saved",
      "label": "SAVED",
      "icon": "star",
      "screen": "saved",
      "badge": "{{length(saved) > 0 ? length(saved) : ''}}"
