  "saved": {
   "type": "screen",
   "id": "saved",
   "content": {
    "navigationBar": {
     "title": "Saved",
     "tintColor": "#000000"
    },
    "style": {
     "material": [
      {
       "id": "fFFFFFF",
       "type": "fill",
       "content": {
        "solid": "#FFFFFF"
       }
      }
     ]
    },
    "children": [
     {
      "id": "savedScroll",
      "type": "scrollView",
      "content": {
       "properties": {
        "direction": "vertical"
       },
       "layout": {
        "constraints": [
         {
          "type": "top",
          "target": "superview"
         },
         {
          "type": "leading",
          "target": "superview"
         },
         {
          "type": "trailing",
          "target": "superview"
         },
         {
          "type": "bottom",
          "target": "superview"
         }
        ]
       },
       "children": [
        {
         "id": "grid",
         "type": "collection",
         "content": {
          "properties": {
           "data": "{{products}}",
           "templateName": "Card",
           "layout": {
            "type": "grid",
            "columns": 2,
            "itemSpacing": 2,
            "lineSpacing": 16,
            "scrollEnabled": false,
            "estimatedItemHeight": 300
           }
          },
          "layout": {
           "constraints": [
            {
             "type": "top",
             "target": "superview"
            },
            {
             "type": "leading",
             "target": "superview"
            },
            {
             "type": "trailing",
             "target": "superview"
            },
            {
             "type": "bottom",
             "target": "superview"
            }
           ]
          },
          "actions": {
           "onItemTap": [
            {
             "type": "navigation",
             "nextScreen": "product",
             "presentation": "push",
             "params": {
              "product": "{{item}}"
             },
             "transition": {
              "preset": "zoom",
              "sourceKey": "{{'card-' + item.id}}",
              "alignmentKey": "fit-0"
             }
            }
           ]
          }
         }
        }
       ]
      }
     }
    ]
   }
  },
