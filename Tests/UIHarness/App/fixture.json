       "layout": {
        "constraints": [
         {
          "type": "top",
          "target": "superview"
         },
         {
          "type": "leading",
          "target": "superview"
         },
         {
          "type": "trailing",
          "target": "superview"
         },
         {
          "type": "bottom",
          "target": "superview"
         }
        ]
       }
      }
     }
    ]
   }
  },
  "product": {
   "type": "screen",
   "id": "product",
   "content": {
    "hidesTabBar": true,
    "navigationBar": {
     "tintColor": "#000000",
     "backLabel": "",
     "rightActions": [
      {
       "icon": "{{includes(saved, product.id) ? 'star.fill' : 'star'}}",
       "action": [
        {
         "type": "toggleArrayValue",
         "variableName": "saved",
         "value": "{{product.id}}"
        }
       ]
      }
     ]
    },
    "style": {
     "material": [
      {
       "id": "fFFFFFF",
       "type": "fill",
       "content": {
        "solid": "#FFFFFF"
       }
      }
     ]
    },
    "variables": {
     "galleryPage": {
      "type": "number",
      "initialValue": 0
     }
    },
    "bottomBar": {
     "component": {
      "id": "buyBar",
      "type": "view",
      "content": {
       "style": {
        "material": [
         {
          "id": "f000000",
          "type": "fill",
          "content": {
           "solid": "#000000"
          }
         }
        ]
       },
       "layout": {
        "height": 50
       },
       "children": [
        {
         "id": "buyLabel",
