    "initialTab": "home",
    "tintColor": "#FFFFFF",
    "unselectedColor": "#FFFFFF4D",
    "badgeColor": "#FFFFFF",
    "badgeTextColor": "#000000",
    "barStyle": {
     "variant": "text",
     "shape": "floating",
     "background": "#000000",
     "cornerRadius": 0,
     "height": 32,
     "selection": "opacity",
