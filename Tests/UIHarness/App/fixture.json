            {
             "type": "centerX",
             "target": "superview"
            },
            {
             "type": "centerY",
             "target": "superview"
            }
           ]
          }
         }
        }
       ]
      }
     },
     "insets": {
      "top": 8,
      "left": 16,
      "bottom": 8,
      "right": 16
     }
    },
    "children": [
     {
      "id": "pdpScroll",
      "type": "scrollView",
      "content": {
       "properties": {
        "direction": "vertical",
        "showsIndicator": false,
        "contentInsetAdjustment": "never",
        "stretchesTopChild": true
       },
