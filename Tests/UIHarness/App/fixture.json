 "styles": [],
 "components": [
  {
   "id": "ShowPage",
   "type": "view",
   "content": {
    "style": {
     "material": [
      {
       "id": "f000000",
       "type": "fill",
       "content": {
        "solid": "#000000"
       }
      }
     ]
    },
    "children": [
     {
      "id": "pagePhoto",
      "type": "image",
      "content": {
       "properties": {
        "type": "remoteAsset",
        "name": "{{item.img}}"
       },
       "style": {
        "contentMode": "scaleAspectFill"
       },
       "layout": {
        "constraints": [
         {
          "type": "top",
          "target": "superview"
         },
         {
          "type": "leading",
          "target": "superview"
         },
         {
          "type": "trailing",
          "target": "superview"
         },
         {
          "type": "bottom",
          "target": "superview"
         }
        ]
       },
       "interaction": {
        "clipsToBounds": "true"
       },
       "transition": {
        "key": "{{'show-' + item.id}}"
       }
      }
     },
     {
      "id": "pageText",
      "type": "label",
      "content": {
       "properties": {
        "text": "{{item.title}}",
        "numberOfLines": 1
       },
       "style": {
        "text": {
         "fontSize": 28,
         "fontWeight": "bold",
         "color": "#FFFFFF"
        }
       },
       "layout": {
        "constraints": [
         {
          "type": "leading",
          "target": "superview",
          "constant": 16
         },
         {
          "type": "bottom",
          "target": "superview",
          "constant": -120
         }
        ]
       }
      }
     },
     {
      "id": "pageButton",
      "type": "button",
      "content": {
       "properties": {
        "text": ""
       },
       "style": {
        "system": {
         "variant": "plain"
        }
       },
       "layout": {
        "constraints": [
         {
          "type": "top",
          "target": "superview"
         },
         {
          "type": "leading",
          "target": "superview"
         },
         {
          "type": "trailing",
          "target": "superview"
         },
         {
          "type": "bottom",
          "target": "superview"
         }
        ]
       },
       "accessibility": {
        "label": "{{'open ' + item.id}}"
       },
       "actions": {
        "tap": [
         {
          "type": "navigation",
          "nextScreen": "product",
          "presentation": "push",
          "params": {
           "product": "{{item}}"
          },
          "transition": {
           "preset": "zoom",
           "sourceKey": "{{'show-' + item.id}}",
           "alignmentKey": "gallery-0"
          }
         }
        ]
       }
      }
     }
    ]
   }
  },
  {
   "id": "Card",
   "type": "view",
   "content": {
    "children": [
     {
      "id": "cardBox",
      "type": "view",
      "content": {
       "layout": {
        "constraints": [
         {
          "type": "top",
          "target": "superview"
         },
         {
          "type": "leading",
          "target": "superview"
         },
         {
          "type": "trailing",
          "target": "superview"
         },
         {
          "type": "height",
          "target": "superview",
          "attribute": "width",
          "multiplier": 1.25
         }
        ]
       },
       "children": [
        {
         "id": "cardImage",
         "type": "image",
         "content": {
          "properties": {
           "type": "remoteAsset",
           "name": "{{item.img}}"
          },
          "style": {
           "contentMode": "scaleAspectFill"
          },
          "layout": {
           "constraints": [
            {
             "type": "top",
             "target": "superview"
            },
            {
             "type": "leading",
             "target": "superview"
            },
            {
             "type": "trailing",
             "target": "superview"
            },
            {
             "type": "bottom",
             "target": "superview"
            }
           ]
          },
          "interaction": {
           "clipsToBounds": "true"
          },
          "transition": {
           "key": "{{'card-' + item.id}}"
          }
         }
        }
       ]
      }
     },
     {
      "id": "cardTitle",
      "type": "label",
      "content": {
       "properties": {
        "text": "{{item.title}}",
        "numberOfLines": 1
       },
       "style": {
        "text": {
         "fontSize": 12
        }
       },
       "layout": {
        "constraints": [
         {
          "type": "top",
          "target": "cardBox",
          "attribute": "bottom",
          "constant": 8
         },
         {
          "type": "leading",
          "target": "superview",
          "constant": 8
         },
         {
          "type": "bottom",
          "target": "superview",
          "constant": -8
         }
        ]
       }
      }
     }
    ],
    "accessibility": {
     "label": "{{'card ' + item.id}}"
    },
    "contextMenu": {
     "preview": {
      "component": {
       "templateId": "QuickView"
      },
      "width": 300,
      "cornerRadius": 0
     },
     "items": [
      {
       "id": "save",
       "title": "Save",
       "icon": "star",
       "actions": [
        {
         "type": "toggleArrayValue",
         "variableName": "saved",
         "value": "{{item.id}}"
        }
       ]
      },
      {
       "id": "view",
       "title": "View product",
       "icon": "arrow.up.right",
       "actions": [
        {
         "type": "navigation",
         "nextScreen": "product",
         "presentation": "push",
         "params": {
          "product": "{{item}}"
         },
         "transition": {
          "preset": "zoom",
          "sourceKey": "{{'card-' + item.id}}",
          "alignmentKey": "fit-0"
         }
        }
       ]
      }
     ],
     "onPreviewTap": [
      {
       "type": "navigation",
       "nextScreen": "product",
       "presentation": "push",
       "params": {
        "product": "{{item}}"
       },
       "transition": {
        "preset": "zoom",
        "sourceKey": "{{'card-' + item.id}}",
        "alignmentKey": "fit-0"
       }
      }
     ]
    }
   }
  },
  {
   "id": "QuickView",
   "type": "view",
   "content": {
    "style": {
     "material": [
      {
       "id": "fFFFFFF",
       "type": "fill",
       "content": {
        "solid": "#FFFFFF"
       }
      }
     ]
    },
    "children": [
     {
      "id": "qvImage",
      "type": "image",
      "content": {
       "properties": {
        "type": "remoteAsset",
        "name": "{{item.img}}"
       },
       "style": {
        "contentMode": "scaleAspectFill"
       },
       "layout": {
        "constraints": [
         {
          "type": "top",
          "target": "superview"
         },
         {
          "type": "leading",
          "target": "superview"
         },
         {
          "type": "trailing",
          "target": "superview"
         },
         {
          "type": "height",
          "target": "superview",
          "attribute": "width",
          "multiplier": 1.25
         }
        ]
       },
       "interaction": {
        "clipsToBounds": "true"
       }
      }
     },
     {
      "id": "qvText",
      "type": "stackView",
      "content": {
       "properties": {
        "axis": "vertical",
        "spacing": 6,
        "alignment": "fill"
       },
       "layout": {
        "constraints": [
         {
          "type": "top",
          "target": "qvImage",
          "attribute": "bottom",
          "constant": 12
         },
         {
          "type": "leading",
          "target": "superview",
          "constant": 16
         },
         {
          "type": "trailing",
          "target": "superview",
          "constant": -16
         },
         {
          "type": "bottom",
          "target": "superview",
          "constant": -16
         }
        ]
       },
       "children": [
        {
         "id": "qvTitle",
         "type": "label",
         "content": {
          "properties": {
           "text": "{{item.title}}"
          },
          "style": {
           "text": {
            "fontSize": 13,
            "fontWeight": "semibold"
           }
          }
         }
        },
        {
         "id": "qvPrice",
         "type": "label",
         "content": {
          "properties": {
           "text": "{{item.price}}"
          },
          "style": {
           "text": {
            "fontSize": 13
           }
          }
         }
        }
       ]
      }
     }
    ]
   }
  }
 ],
 "screens": {
  "tabs": {
   "type": "tabBarScreen",
